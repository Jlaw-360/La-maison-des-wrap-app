{
  "name": "la-maison-des-wraps-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:apk": "npx eas-cli build -p android --profile preview",
    "build:android:prod": "npx eas-cli build -p android --profile production",
    "build:ios:sim": "npx eas-cli build -p ios --profile preview",
    "build:ios:device": "npx eas-cli build -p ios --profile preview-device",
    "build:ios:prod": "npx eas-cli build -p ios --profile production",
    "build:all": "npx eas-cli build --platform all --profile preview",
    "update:preview": "npx eas-cli update --channel preview --message",
    "update:prod": "npx eas-cli update --channel production --message"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~52.0.0",
    "expo-app-metrics": "^0.1.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-observe": "^0.1.9",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
