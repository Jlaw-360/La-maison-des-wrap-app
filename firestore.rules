rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isStaff() {
      return isAdmin() || isRole('store') || isRole('driver');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Menu Items & Dishes - Publicly viewable, editable only by Admin/Store
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /dishes/{dishId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 2. Restaurant Info, Hours, Delivery Zones & Taxes - Public read, Admin write
    match /restaurant_info/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /loyalty_rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. User Profiles - Self-registration default 'customer', role escalation blocked
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // On create, user role must be 'customer' unless created by Admin
      allow create: if request.resource.data.role == 'customer' || isAdmin();
      // On update, users cannot change their own role to admin/store/driver
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Orders - Customers create their orders; Kitchen and Drivers update status
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customer_id == request.auth.uid || isStaff());
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isOwner(resource.data.customer_id) && resource.data.status == 'received');
      allow delete: if isAdmin();
    }

    // 5. Multi-Role Live Chats & Doorstep Proof Messages
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }
    match /orders/{orderId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
  }
}
