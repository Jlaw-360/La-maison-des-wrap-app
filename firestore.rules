rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Collection 'menu_items'
    // - Create: Authenticated Users
    // - Read: Everyone (Publicly accessible so guests can browse the menu)
    // - Write: Authenticated Users
    // - Delete: No One
    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // 2. Collection 'users'
    // - Create: Everyone (Allows new sign-ups)
    // - Read: Authenticated Users
    // - Write: User Document Owner (Users can only update their own profile)
    // - Delete: No One
    match /users/{userId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // 3. Collection 'orders'
    // - Create: Authenticated Users (Customers place orders)
    // - Read: Authenticated Users (Customers view their orders; kitchen and drivers view assigned orders)
    // - Write: Authenticated Users (Kitchen updates prep status; drivers update delivery progress)
    // - Delete: No One
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // 4. Collection 'chats'
    // - Create: Authenticated Users
    // - Read: Authenticated Users
    // - Write: Authenticated Users
    // - Delete: No One
    match /chats/{chatId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // Nested Chat Messages (if subcollection used)
    match /orders/{orderId}/chats/{messageId} {
      allow create, read, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
