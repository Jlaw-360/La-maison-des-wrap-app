rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isStore() {
      return isAuthenticated() && (getUserData().role == 'store' || getUserData().role == 'admin');
    }
    
    function isDriver() {
      return isAuthenticated() && getUserData().role == 'driver';
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isStore());
      allow delete: if isStore();
    }

    // 2. Menu Items Collection (Public read, Store write)
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isStore();
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      // Customers can read their own orders; Store & Drivers can read active orders
      allow read: if isAuthenticated() && (
        resource.data.customer_uid == request.auth.uid ||
        isStore() ||
        isDriver()
      );
      // Customers create orders with their own UID
      allow create: if isAuthenticated() && request.resource.data.customer_uid == request.auth.uid;
      // Store can update all statuses; Drivers can update when claiming or delivering
      allow update: if isAuthenticated() && (
        isStore() ||
        (isDriver() && (resource.data.driver_uid == request.auth.uid || resource.data.status == 'ready'))
      );
      allow delete: if isStore();
    }

    // 4. Live Order Chat Messages
    match /orders/{orderId}/chats/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Inventory & 86 Item Toggles
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStore();
    }
  }
}
